{
  "expo": {
    "name": "Simple Syncing Audiobook",
    "slug": "simple-syncing-audiobook",
    "version": "1.0.3",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "scheme": "simple-syncing-audiobook",
    "userInterfaceStyle": "automatic",
    "android": {
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.simplesyncing.audiobook"
    },
    "plugins": [
      "expo-router",
      "expo-document-picker",
      "expo-system-ui",
      "expo-secure-store",
      "./plugins/withReleaseSigning"
    ],
    "ios": {
      "bundleIdentifier": "com.simplesyncing.audiobook",
      "infoPlist": {
        "UIBackgroundModes": ["audio"]
      }
    }
  }
}
